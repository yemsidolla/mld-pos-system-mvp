DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
APP_VERSION=1.0.0-mvp
WEB_HOST_PORT=8000

POSTGRES_DB=melodu_pos
POSTGRES_USER=melodu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

TIME_ZONE=Asia/Phnom_Penh

# --- Media storage / Garage (S3-compatible) ---
# USE_S3_MEDIA=False keeps local filesystem media under data/media.
# USE_S3_MEDIA=True stores uploaded/generated media in Garage via S3 API.
USE_S3_MEDIA=True
# Generate a unique value with: openssl rand -hex 32
# The placeholder below is valid hex for local smoke tests only — replace before any shared use.
GARAGE_RPC_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Optional admin API token (CLI via docker exec works without it).
GARAGE_ADMIN_TOKEN=
GARAGE_S3_HOST_PORT=3900
S3_STORAGE_BUCKET_NAME=melodu-media
S3_ACCESS_KEY_ID=melodu_garage
S3_SECRET_ACCESS_KEY=change-me-garage-secret-key
S3_ENDPOINT_URL=http://garage:3900
# Optional public host used in generated media URLs.
# For production, proxy Garage S3 through HTTPS and set this without scheme:
# S3_CUSTOM_DOMAIN=melodu-media.khlovepet.com
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=us-east-1
S3_QUERYSTRING_AUTH=True
S3_QUERYSTRING_EXPIRE=3600

# --- V6 identity / Authentik OIDC ---
# AUTH_MODE=local keeps classic username/password login (rollback mode).
# AUTH_MODE=oidc enables "Continue with Melodu Staff Login" via Authentik.
AUTH_MODE=local
# Keep true so the emergency local form (?local=1) works if Authentik is down.
LOCAL_LOGIN_ENABLED=True
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SIGN_ALGO=RS256
OIDC_SCOPES="openid email profile"
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.khlovepet.com/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.khlovepet.com/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.khlovepet.com/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.khlovepet.com/application/o/melodu-pos/jwks/
OIDC_OP_LOGOUT_ENDPOINT=https://auth.khlovepet.com/application/o/melodu-pos/end-session/
OIDC_GROUPS_CLAIM=groups
OIDC_AUTO_CREATE_USER=True
OIDC_SYNC_GROUPS=True
