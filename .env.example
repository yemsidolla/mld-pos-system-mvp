DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
APP_VERSION=1.0.0-mvp
WEB_HOST_PORT=8000

POSTGRES_DB=melodu_pos
POSTGRES_USER=melodu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

TIME_ZONE=Asia/Phnom_Penh

# --- V6 identity / Authentik OIDC ---
# AUTH_MODE=local keeps classic username/password login (rollback mode).
# AUTH_MODE=oidc enables "Continue with Melodu Staff Login" via Authentik.
AUTH_MODE=local
# Keep true so the emergency local form (?local=1) works if Authentik is down.
LOCAL_LOGIN_ENABLED=True
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SIGN_ALGO=RS256
OIDC_SCOPES=openid email profile
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.khlovepet.com/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.khlovepet.com/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.khlovepet.com/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.khlovepet.com/application/o/melodu-pos/jwks/
OIDC_OP_LOGOUT_ENDPOINT=https://auth.khlovepet.com/application/o/melodu-pos/end-session/
OIDC_GROUPS_CLAIM=groups
OIDC_AUTO_CREATE_USER=True
OIDC_SYNC_GROUPS=True
